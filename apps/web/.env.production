# Real root cause of executar-nf-web's production build failing 100% of
# the time (confirmed from Vercel's own build log, not assumed):
# packages/next-config/keys.ts requires NEXT_PUBLIC_APP_URL and
# NEXT_PUBLIC_WEB_URL (z.url(), no .optional()) for any app that extends
# it — apps/web does. NEXT_PUBLIC_WEB_URL specifically has never been
# present in this Vercel project's Production environment (the dashboard
# claim to the contrary in LAUNCH_RUNBOOK.md §2 is DRIFT — the live build
# log says otherwise), and no Vercel MCP tool in any session so far has
# been able to write project environment variables to fix it there.
#
# These are NEXT_PUBLIC_* values: by definition they ship into the
# client-side JS bundle and are visible to every visitor's browser
# already, so there is no secrecy to protect by keeping them
# dashboard-only. Next.js loads .env.production for production builds
# (both `next build` locally and Vercel's own build step run the same
# loader) automatically, with no extra config — and it never overrides
# a value the platform already injects via its own dashboard
# (documented Next.js precedence: existing process.env wins over any
# .env file), so this is additive, not a conflict with whatever is or
# isn't set in Vercel's UI. Not gitignored — checked .gitignore's
# `.env*` rules match only `.env`, `.env*.local`, and
# `.env.production.local`, never plain `.env.production`.
#
# Values match the real, already-deployed URLs (confirmed via each
# project's own Vercel API response and via apps/app's own rendered
# output, which already links to executar-nf-web-sas-executar1's exact
# domain for its /legal/privacy and /legal/terms routes).
NEXT_PUBLIC_APP_URL="https://executar-nf-app-sas-executar1.vercel.app"
NEXT_PUBLIC_WEB_URL="https://executar-nf-web-sas-executar1.vercel.app"
NEXT_PUBLIC_API_URL="https://executar-nf-api-sas-executar1.vercel.app"
