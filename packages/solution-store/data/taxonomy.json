        "examples": ["ebook", "guide"],
        "default_downloadable": true,
        "default_interactive": false
      },
      {
        "id": "article",
        "label": "Artigos",
        "description": "Conteúdo editorial publicado na Oficina ou no blog.",
        "examples": ["article", "tutorial", "editorial"],
        "default_downloadable": false,
        "default_interactive": false
      },
      {
        "id": "prompt",
        "label": "Prompts",
        "description": "Prompts reutilizáveis para execução direta ou cópia.",
        "examples": ["prompt", "prompt pack"],
        "default_downloadable": true,
        "default_interactive": true
      },
      {
        "id": "plugin",
        "label": "Plugins",
        "description": "Integrações instaláveis que expõem capacidades, conectores, tools ou prompts.",
        "examples": ["plugin", "connector package"],
        "default_downloadable": false,
        "default_interactive": true
      },
      {
        "id": "photo_prompt",
        "label": "Photo-prompts",
        "description": "Prompts orientados à criação ou transformação visual.",
        "examples": ["photo prompt", "image prompt"],
        "default_downloadable": true,
        "default_interactive": true
      }
