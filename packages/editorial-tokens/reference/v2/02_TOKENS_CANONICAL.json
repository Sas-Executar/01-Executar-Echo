      "labelSecondary": "#6E6E73",
      "labelTertiary": "#86868B",
      "separator": "rgba(60,60,67,0.18)",
      "fillPrimary": "rgba(120,120,128,0.20)",
      "fillSecondary": "rgba(120,120,128,0.12)",
      "accent": "#FFCC00",
      "focus": "#0A84FF",
      "success": "#34C759",
      "warning": "#FF9F0A",
      "error": "#FF3B30"
    },
    "dark": {
      "background": "#000000",
      "groupedBackground": "#1C1C1E",
      "surfaceElevated": "rgba(28,28,30,0.78)",
      "labelPrimary": "#F5F5F7",
      "labelSecondary": "#AEAEB2",
      "labelTertiary": "#8E8E93",
      "separator": "rgba(84,84,88,0.65)",
