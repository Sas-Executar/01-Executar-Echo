      "success": "#30D158",
      "warning": "#FF9F0A",
      "error": "#FF453A"
    }
  },
  "typography": {
    "uiFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif",
    "displayFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, sans-serif",
    "displayXL": {
      "size": "clamp(2.5rem, 5vw, 4rem)",
      "lineHeight": 1.04,
      "weight": 700,
      "tracking": "-0.025em"
    },
    "title1": {
      "size": "2rem",
      "lineHeight": 1.12,
      "weight": 700,
      "tracking": "-0.02em"
    },
    "title2": {
      "size": "1.625rem",
      "lineHeight": 1.18,
      "weight": 650,
      "tracking": "-0.015em"
    },
    "title3": {
      "size": "1.25rem",
      "lineHeight": 1.25,
      "weight": 600,
      "tracking": "-0.01em"
    },
    "body": {
      "size": "1.0625rem",
      "lineHeight": 1.6,
      "weight": 400
    },
    "callout": {
      "size": "1rem",
      "lineHeight": 1.5,
      "weight": 500
    },
    "subheadline": {
      "size": "0.9375rem",
      "lineHeight": 1.45,
      "weight": 500
    },
    "footnote": {
      "size": "0.8125rem",
      "lineHeight": 1.4,
      "weight": 400
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
