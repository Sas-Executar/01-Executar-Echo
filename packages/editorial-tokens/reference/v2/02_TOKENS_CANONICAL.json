  "border": {
    "hairline": "1px"
  },
  "shadow": {
    "chrome": "0 8px 32px rgba(0,0,0,0.08)",
    "content": "none"
  },
  "material": {
    "chromeBackground": "var(--surface-elevated)",
    "chromeBlur": "24px",
    "chromeSaturation": "140%"
  },
  "layout": {
    "articleMeasure": "66ch",
    "readingMax": "760px",
    "contentMax": "1180px",
    "pageGutterMobile": "20px",
    "pageGutterTablet": "32px",
    "pageGutterDesktop": "40px",
